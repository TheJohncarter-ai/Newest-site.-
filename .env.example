# ============================================================
# WALLET — NEVER commit actual values. Keep .env in .gitignore.
# ============================================================
# Generate a new wallet with: python -m agent.main --create-wallet
WALLET_PRIVATE_KEY=0x_your_private_key_here
WALLET_ADDRESS=0x_your_polygon_address_here

# ============================================================
# RPC PROVIDERS
# Free keys at: https://alchemy.com  and  https://infura.io
# ============================================================
ALCHEMY_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
INFURA_POLYGON_RPC=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY
# Fallback public RPC (rate-limited, use only as last resort)
PUBLIC_POLYGON_RPC=https://polygon-rpc.com

# ============================================================
# AI BRAIN
# Get your key at: https://console.anthropic.com
# ============================================================
ANTHROPIC_API_KEY=sk-ant-your_key_here

# ============================================================
# DEX API KEYS
# 1inch free tier: https://portal.1inch.dev
# ============================================================
ONEINCH_API_KEY=your_1inch_api_key

# ============================================================
# AGENT BEHAVIOR
# ============================================================
# Set DRY_RUN=true to simulate without executing real transactions
DRY_RUN=false
LOG_LEVEL=INFO
LOG_FILE=agent/data/agent.log
PORTFOLIO_DB=agent/data/portfolio.jsonl

# ============================================================
# RISK OVERRIDES (optional — defaults are in agent/config.py)
# ============================================================
# MAX_DRAWDOWN_PCT=0.30
# MIN_STABLECOIN_PCT=0.30
# DECISION_INTERVAL_SECONDS=1800
